Задача 3

print("Введите количество студентов")
n=int(input())
print("Введите голоса студентов в столбик")
Golosa=[]
for i in range(n):
    x=int(input())
    Golosa.append(x)
p=n//2
f=0
for i in range(n):
    if Golosa.count(Golosa[i])> p:
        print("За проект под номером ",Golosa[i]," проголосовало больше половины студентов")
        f=1
        break
if f==0:
    print("Такого проекта нет")

Задача 4

print("Введите количество оценок студентов")
n=int(input())
Ocenki=[]
print("Введите оценки студентов в столбик")
for i in range(n):
    x=int(input())
    Ocenki.append(x)
dlin=1
ma=0
for i in range(n-1):
    if Ocenki[i]==Ocenki[i+1]:
        dlin+=1
    else:
        if dlin>ma:
            ma=dlin
            dlin=0
        else:
            dlin=0
print(ma)

