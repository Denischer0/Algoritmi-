Задача 1

print("Введите количество взятых бейджиков")
n=int(input())
Vsyatie=[]
Otdannie=[]
print("Введите номера взятых бейджиков в столбик")
for i in range (n):
    x=int(input())
    Vsyatie.append(x)
print("Введите номера отданных бейджиков")
for i in range (n):
    x=str(input())
    if x=="":
        break
    else:
        Otdannie.append(int(x))
l=len(Vsyatie)
for i in range(l):
    if not(Vsyatie[i] in Otdannie):
        print("Бейджик под номером ",Vsyatie[i]," не был возвращён")           

