#include <iostream>
#include <vector>
#include <cmath>
#include <string> 
using namespace std;
int main() {
	cout << "Vvedite luboye pyatiznachnoe chislo" << endl;
	int n;
	cin >> n;

	if (to_string(n).size() != 5) {
		cout << "Vvedeno nekorektnoye chislo";
		exit(0);
	}
	int n1 = n, l;
	string n2,n3;
	for (int i = 0; i < 5; i++) {
		n1 = n * n;
		l = to_string(n1).size();
		l = l / 4-1;
		n2 = to_string(n1);	
		n3 = n2[l] + n2[l + 1] + n2[l + 2] + n2[l + 3] + n2[l + 4];
		cout << n2 << endl << n3 << endl;

	}
}
