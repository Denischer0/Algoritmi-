#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
vector<int> metod_ferma(int n, int delitel1, int delitel2) {
    int m = sqrt(n);
    int x = 1;
    int q = 0;
    int koren_iz_q = 0;
    int koren=sqrt(n);
    if (koren * koren == n) {
        delitel1 = koren;
        delitel2 = koren;
        vector<int> A = { delitel1,delitel2 };
        return A;
    }
    else {
        while (true) {

            q = (m + x) * (m + x) - n;
            koren_iz_q = sqrt(q);
            if (koren_iz_q * koren_iz_q == q) {
                break;
            }
            else {
                x++;
            }
        }
    }

    delitel1 = (m + x) - koren_iz_q;
    delitel2 = (m + x) + koren_iz_q;
    vector<int> A = { delitel1,delitel2 };
    return A;
}
int reshet(int n) {
    int ff = 0, h = 0;
    vector<int> resheto;
    vector<int> a;
    for (int i = 0; i <= n + 1; i++) {
        a.push_back(i);
    }
    for (int i = 2; i * i <= n + 1; i++) {
        if (a[i] != 0) {
            for (int j = i * i; j <= n + 1; j += i) {
                a[j] = 0;
            }
        }
    }
    for (int i = 2; i < n + 1; i++) {
        if (a[i] != 0)
        {
            resheto.push_back(a[i]);
        }
    }
    while (h < resheto.size()) {
        if (resheto[h] == n) {
            ff = 1;
            break;
        }
        h++;
    }
    return ff;
}
int main() {
    vector<int> deliteli;
    cout << "Vvedite polozhitelnoe nechetnoye chislo" << endl;
    int n;
    cin >> n;
    if (n <= 0 or n % 2 == 0) {
        cout << "Vvedeno nekorektnoe chislo";
        exit(0);
    }
    if (reshet(n) == 1 or n==1) {
        cout << "factorizatsiya chisla " << n << ": " << n << "^1" << endl;
        exit(0);
    }
    int delitel1;
    int delitel2;
    cout << "factorizatsiya chisla " << n << ": ";
    vector<int> A;
    vector<int> neprostie_chisla;
    neprostie_chisla.push_back(n);
   
    while (neprostie_chisla.size() > 0) {
        A = metod_ferma(neprostie_chisla[0], 0, 0);
        delitel1 = A[0];
        delitel2 = A[1];
       
        if (reshet(delitel1) == 1 and reshet(delitel2) == 1) {
            deliteli.push_back(delitel1);
            deliteli.push_back(delitel2);
            neprostie_chisla.erase(neprostie_chisla.begin());
        }
        else if (reshet(delitel1) == 1 and reshet(delitel2) == 0) {
            deliteli.push_back(delitel1);
            neprostie_chisla.push_back(delitel2);
            neprostie_chisla.erase(neprostie_chisla.begin());

        }
        else if (reshet(delitel1) == 0 and reshet(delitel2) == 1) {
            deliteli.push_back(delitel2);
            neprostie_chisla.push_back(delitel1);
            neprostie_chisla.erase(neprostie_chisla.begin());

        }
        else if (reshet(delitel1) == 0 and reshet(delitel2) == 0) {
            neprostie_chisla.push_back(delitel1);
            neprostie_chisla.push_back(delitel2);
            neprostie_chisla.erase(neprostie_chisla.begin());
        }
    }
    sort(deliteli.begin(), deliteli.end());
    int f2 = 0;
    int len = deliteli.size(), f1 = 1;
    while (f2 != len - 1) {
        if (deliteli[f2] == deliteli[f2 + 1]) {
            f1++;
            f2++;
        }
        else {
            cout << deliteli[f2] << "^" << f1 << " * ";
            f1 = 1;
            f2++;
        }
    }
    if (f1 != deliteli.size()) {
        cout << deliteli[deliteli.size() - 1] << "^1";
    }
    else {
        cout << deliteli[f2] << "^" << f1;
    }
}   
