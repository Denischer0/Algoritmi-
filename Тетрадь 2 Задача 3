            for (int j = i * i; j <= n + 1; j += i) {
                a[j] = 0;
            }
        }
    }
    for (int i = 2; i < n + 1; i++) {
        if (a[i] != 0)
        {
            resheto.push_back(a[i]);
        }
    }
    while (h < resheto.size()) {
        if (resheto[h] == n) {
            ff = 1;
            break;
        }
        h++;
    }
    return ff;
}
