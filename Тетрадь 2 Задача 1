#include <iostream>
#include <cmath>
#include <string>
using namespace std;
int main() {
	cout << "Vvedite 4 chisla ne ravnih 0" << endl;
	int A, B, C, D;
	cin >> A >> B >> C >> D;
	A = abs(A);
	B = abs(B);
	C = abs(C);
	D = abs(D);
	if (A == 0 or B == 0 or C == 0 or D == 0) {
		cout << "Chisla vvedeni nekorektno";
		exit(0);
	}
	while (A != B) {
		if (A > B) {
			A = A - B;
		}
		else {
			B = B - A;
		}
	}
	while (B != C) {
		if (B > C) {
			B = B - C;
		}
		else {
			C = C - B;
		}
	}
	while (C != D) {
		if (C > D) {
			C = C - D;
		}
		else {
			D = D - C;
		}
	}
	cout << "NOD raven " << D << endl;
}
