#include <iostream>
#include <cmath>
#include <string>
using namespace std;
int nod(int a, int b) {  // функция, которая находит НОД для двух чисел
	while (b != 0) {
		int x = b;
		b = a % b;
		a = x;
	}
	return a;
}
int main() {
	string ch1="";
	cout << "Esli vi budete vvodit 3 chisla - vvedite 1, esli vi budete vvodit 4 chisla - vvedite 2" << endl;
	cin >> ch1;
	if (ch1 == "2") {
		cout << "vvedite 4 chetnih chisla" << endl;
		int A, B, C, D;
		cin >> A >> B >> C >> D;
		A = abs(A);
		B = abs(B);
		C = abs(C);
		D = abs(D);
		if (A == 0 and (B!=0 or C!=0 or D!=0)) {
			cout << "NOD raven " << nod(nod(B,C),D);
		}
		else if (B == 0 and (A != 0 or C != 0 or D != 0)) {
			cout << "NOD raven " << nod(nod(A, C), D);
		}
		else if (C == 0 and (B != 0 or A != 0 or D != 0)) {
			cout << "NOD raven " << nod(nod(A, B), D);
		}
		else if (D == 0 and (B != 0 or C != 0 or A != 0))  {
			cout << "NOD raven " << nod(nod(A, B), C);
		}
		else if (A != 0 and B != 0 and C!=0 and D!=0) {
			while (A != B) {
				if(A>B){
					A = A - B;
				}
				else {
					B = B - A;
				}
			}
			while (B != C) {
				if (B > C) {
					B = B - C;
				}
				else {
					C = C - B;
				}
			}
			while (C != D) {
				if (C > D) {
					C = C - D;
				}
				else {
					D = D - C;
				}
			}
			cout << "NOD raven " << D << endl;
		}
		else {
			cout << "Chisla vvedeni ne correctno" << endl;
		}
	}
	else if (ch1 == "1") {
		cout << "vvedite 3 nechetnih chisla" << endl;
		int A, B, C;
		cin >> A >> B >> C;
		A = abs(A);
		B = abs(B);
		C = abs(C);
		if (A == 0 and (B!=0 or C!=0)) {
			cout << "NOD raven " << nod(B, C);
		}
		else if (B == 0 and (A != 0 or C != 0)) {
			cout << "NOD raven " << nod(A, C);
		}
		else if (C == 0 and (B != 0 or A != 0)) {
			cout << "NOD raven " << nod(A, B);
		}
		else if (A != 0 and B != 0 and C != 0) {
			int x;
			while (B != 0) {
				x = A % B;
				A = B;
				B = x;
			}
			while (C != 0) {
				x = A % C;
				A = C;
				C = x;
			}
			cout << "NOD raven " << A;
		}
		else {
			cout << "Chisla vvedeni ne correctno" << endl;
		}
	}
}
