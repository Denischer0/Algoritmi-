#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main()
{
    cout << "Vvedite polozhitelnoe chislo" << endl;
    int n;
    cin >> n;
    if (n <= 0) {
        cout << "Vvedeno nekorektnoe chislo";
        exit(0);
    }
    vector<int> resheto;
    vector<int> a;
    for (int i = 0; i <= n+1; i++) {
        a.push_back(i);
    }
    for (int i = 2; i * i <= n+1; i++) {
        if (a[i] != 0) {
            for (int j = i * i; j <= n+1; j += i) {
                a[j] = 0;
            }
        }
    }
    for (int i = 2; i < n+1; i++) {
        if (a[i]!=0)
        {
            resheto.push_back(a[i]);
        }
    }
    int h = 0, ff = 0;
    while (h < resheto.size()) {
        if (resheto[h] == n) {
            ff=1;
            break;
        }
        h++;
    }
    if (ff == 1) {
        cout << "factorizatsiya chisla " << n << ": " << n << "^1" << endl;
        exit(0);
    }
    else {
        vector<int> deliteli;
        int f = 0;
        int n1 = n;
        cout << "factorizatsiya chisla " << n << ": ";
       
        while ((f != resheto.size()-1) or (n1!=1) ) {
            if (n1 % resheto[f] == 0) {
                n1 = n1 / resheto[f];
                deliteli.push_back(resheto[f]);
               
            }
            else {
                f++;
            }
        }
            f = 0;
        int len = deliteli.size(), f1 = 1;
        while (f != len - 1) {
            if (deliteli[f] == deliteli[f + 1]) {
                f1++;
                f++;
            }
            else {
                cout << deliteli[f] << "^" << f1 << " * ";
                f1 = 1;
                f++;
            }
        }
        if (f1 != deliteli.size()) {
            cout << deliteli[deliteli.size() - 1] << "^1";
        }
        else {
            cout << deliteli[f] << "^" << f1;
        }
    }
}
