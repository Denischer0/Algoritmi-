#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int n = 1000;

int main()
{
    int n;
    cout << "Vvedite chislo" << endl;
    cin >> n;
    vector<int> resheto;
    vector<int> arr;
    int k = 0;
    while (k != n) {
        arr.push_back(0);
        k++;
    }

    for (int i = 2; i < n; i++)
    {
        for (int j = i * i; j < n; j += i)
        {
            arr[j - 1] = 1;
        }
    }
    for (int i = 1; i < n; i++)
    {
        if (arr[i - 1] == 0)
            resheto.push_back(i);
    }
    if ((count(resheto.begin(), resheto.end(), n)) > 0) {
        cout << "factorizatsiya chisla " << n << ": " << "1 " << n << endl;
        exit(0);
    }
    else  {
        vector<int> deliteli;
        int f = 1;
        int n1 = n;
        cout << "factorizatsiya chisla " << n << ": ";
        while (n1 != 1) {


            while (f != n - 2) {
                if (n1 % resheto[f] == 0) {
                    n1 = n1 / resheto[f];
                    deliteli.push_back(resheto[f]);
                }
                else {
                    f++;
                }
            }
            f = 1;
        }
        int len = deliteli.size(), f1 = 1;
        while (f != len - 1) {
            if (deliteli[f] == deliteli[f + 1]) {
                f1++;
                f++;
            }
            else {
                cout << deliteli[f] << "^" << f1 << "* ";
                f1 = 1;
                f++;
            }
        }
    }
 }





