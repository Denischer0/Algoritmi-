#include <iostream>
#include <vector>

using namespace std;

int main() {
    cout << "Vvedite chislo do kotorogo budet resherto Sundurama" << endl;
    int n, m = 0,nn;
    cin >> nn;
    n = nn / 2-1;
    vector<int> f(n + 1, 0);
    for (int i = 1; i < n; i++) {
        int j = i;
        while (true) {
            m = i + j + 2 * i * j;
            if (m > n) {
                break;
            }
            f[m] = 1;
            j++;
        }
    }
    cout << 2 << " ";
    for (int m = 1; m <= n; m++) {
        if (f[m] == 0) {
            cout << 2 * m + 1 << " ";
        }
    }
    cout << endl;
};
