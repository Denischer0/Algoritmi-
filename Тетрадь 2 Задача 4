#include <iostream>
#include <vector>
#include <cmath>
using namespace std;
int reshet(int n) {
	int ff = 0, h = 0;
	vector<int> resheto;
	vector<int> a;
	for (int i = 0; i <= n + 1; i++) {
		a.push_back(i);
	}
	for (int i = 2; i * i <= n + 1; i++) {
		if (a[i] != 0) {
			for (int j = i * i; j <= n + 1; j += i) {
				a[j] = 0;
			}
		}
	}
	for (int i = 2; i < n + 1; i++) {
		if (a[i] != 0)
		{
			resheto.push_back(a[i]);
		}
	}
	while (h < resheto.size()) {
		if (resheto[h] == n) {
			ff = 1;
			break;
		}
		h++;
	}
	return ff;
}
int main() {
	cout << "Vvedite nomer chisla Mersenna. Nomer dolzhen bit prostim nechetnim chislom" << endl;
	int n,k=1,S=4;
	cin >> n;
	if (n % 2 == 0 or reshet(n)==0) {
		cout << "Vvedeno nekorektnoe chislo" << endl;
		exit(0);
	}
	
	int M = pow(2,n) - 1;
	while (k != n - 1) {
		S = ((S * S) - 2) % M;
		k++;
	}
	if (S == 0) {
		cout << "chislo " << M << " prostoye";
	}
	else {
		cout << "chislo " << M << " sostavnoye";
	}
}
