void print(vector<int> x) {
	cout << endl;
	for (int i = 0; i < x.size(); i++) {							
		cout << x[i] << " ";
	}
}
vector<int> reverse(vector<int> x) {
	vector<int> y = {};
	for (int i = x.size() - 1; i >= 0; i--) {
		y.push_back(x[i]);
	}
	return y;
}
vector<int> dobav(vector<int> x) {
	vector <int> y = { 0 };
	for (int i = 0; i < x.size(); i++) {
		y.push_back(x[i]);
	}
	return y;
}
