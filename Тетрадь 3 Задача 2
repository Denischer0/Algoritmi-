#include <iostream>
#include <vector>
#include <string>
using namespace std;
void print(vector<int> x, vector<int> y) {
	cout << endl;
	for (int i = 0; i < x.size(); i++) {
		cout << x[i] << " ";
	}
	cout << endl;
	for (int i = 0; i < y.size(); i++) {
		cout << y[i] << " ";
	}
}
vector<int> reverse(vector<int> x) {
	vector<int> y = {};
	for (int i = x.size() - 1; i >= 0; i--) {
		y.push_back(x[i]);
	}
	return y;
}
